; MTOS calibration reader for the 24 MHz C167, BRS=0.
; MTRD at startup baud; A5 authorizes each block. CRC16/Modbus LE follows data.
; Preserve registers/UART. No flash writes. Firmware ends the MTOS session.
$MOD167
$INCLUDE (REG167.INC)
START EQU 090000H
LENGTH EQU 0H                 ; zero in the 16-bit counter means 65536 bytes
BAUD_RELOAD EQU 0H
BLOCK_SIZE EQU 78H            ; leave room for the ACK echo in the adapter FIFO
MTOS SECTION CODE AT 0C014H
Main PROC FAR
    PUSH R1
    PUSH R2
    PUSH R3
    PUSH R4
    PUSH R5
    PUSH R6
    PUSH R7
    PUSH S0TIC
    PUSH S0RIC
    PUSH S0BG
    PUSH S0CON
    PUSH R12
    BCLR S0RIE
    BCLR S0TIE
    MOVB RL1,#'M'
    CALLS SEG EchoByte, SOF EchoByte
    CMP R2,#0
    JMPA cc_EQ,Restore
    MOVB RL1,#'T'
    CALLS SEG EchoByte, SOF EchoByte
    CMP R2,#0
    JMPA cc_EQ,Restore
    MOVB RL1,#'R'
    CALLS SEG EchoByte, SOF EchoByte
    CMP R2,#0
    JMPA cc_EQ,Restore
    MOVB RL1,#'D'
    CALLS SEG EchoByte, SOF EchoByte
    CMP R2,#0
    JMPA cc_EQ,Restore
    BCLR S0BRS
    MOV S0BG,#BAUD_RELOAD
    MOV R4,#POF START
    MOV R5,#LENGTH
    MOV R6,#PAG START
    MOV R7,#0FFFFH
WaitHost:
    MOV R2,#128
    MOV R3,#0
HostPoll:
    SRVWDT
    JB S0RIR,HostByte
    SUB R3,#1
    JMPR cc_NE,HostPoll
    SUB R2,#1
    JMPR cc_NE,HostPoll
    JMPA cc_UC,Restore
HostByte:
    MOVB RL1,S0RBUF
    BCLR S0RIR
    CMPB RL1,#0A5H
    JMPR cc_NE,HostPoll
    MOV R12,#BLOCK_SIZE
Loop:
    SRVWDT
    EXTP R6,#1
    MOVB RL1,[R4]
    MOVB S0TBUF,RL1
WaitTx:
    ; Drain our own echo before accepting a host ACK at the block boundary.
    JNB S0RIR,WaitTx
    MOVB RL2,S0RBUF
    BCLR S0RIR
    BCLR S0TIR
    MOVBZ R2,RL1
    XOR R7,R2
    MOV R3,#8
CrcLoop:
    SHR R7,#1
    JMPR cc_NC,CrcNext
    XOR R7,#0A001H
CrcNext:
    SUB R3,#1
    JMPR cc_NE,CrcLoop
    ADD R4,#1
    CMP R4,#04000H
    JMPR cc_NE,Next
    MOV R4,#0
    ADD R6,#1
Next:
    SUB R5,#1
    JMPA cc_EQ,SendCRC
    SUB R12,#1
    JMPR cc_NE,Loop
    JMPA cc_UC,WaitHost
SendCRC:
    MOV R1,R7
    CALLS SEG TxByte,SOF TxByte
    SHR R1,#8
    CALLS SEG TxByte,SOF TxByte
    ; Queue a dummy. Once its TX-buffer transfer completes, CRC high is sent.
    MOVB RL1,#0
    CALLS SEG TxByte,SOF TxByte
    ; Wait until that dummy is echoed, so changing baud cannot truncate CRC.
    MOVB RL1,S0RBUF
    BCLR S0RIR
    MOV R3,#0
WaitLast:
    SRVWDT
    JB S0RIR,LastReceived
    SUB R3,#1
    JMPR cc_NE,WaitLast
    JMPR cc_UC,Restore
LastReceived:
    MOVB RL1,S0RBUF
    BCLR S0RIR
Restore:
    POP R12
    POP S0CON
    POP S0BG
    POP S0RIC
    POP S0TIC
    POP R7
    POP R6
    POP R5
    POP R4
    POP R3
    POP R2
    POP R1
    RET
Main ENDP
TxByte PROC FAR
    MOVB S0TBUF,RL1
TxWait:
    JNB S0TIR,TxWait
    BCLR S0TIR
    RET
TxByte ENDP
EchoByte PROC FAR
    MOVB RL2,S0RBUF
    BCLR S0RIR
    CALLS SEG TxByte,SOF TxByte
    MOV R3,#0
EchoWait:
    SRVWDT
    JB S0RIR,GotEcho
    SUB R3,#1
    JMPR cc_NE,EchoWait
    MOV R2,#0
    RET
GotEcho:
    MOVB RL2,S0RBUF
    BCLR S0RIR
    MOV R2,#1
    RET
EchoByte ENDP
MTOS ENDS
END
